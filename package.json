{
  "name": "more-than-chat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm build:host && pnpm --filter @more-than-chat/desktop dev",
    "build:host": "pnpm --filter @more-than-chat/central-protocol build && pnpm --filter @more-than-chat/protocol build && pnpm --filter @more-than-chat/plugin-runtime build && pnpm --filter @more-than-chat/runtime-cordis build && pnpm --filter @more-than-chat/plugin-time-tool build && pnpm --filter @more-than-chat/pc-host build",
    "central:serve": "pnpm --filter @more-than-chat/central-protocol build && pnpm --filter @more-than-chat/central-server start",
    "central:dev": "pnpm --filter @more-than-chat/central-protocol build && node scripts/run-central-dev.mjs",
    "central:package": "pnpm --filter @more-than-chat/central-protocol build && node scripts/stage-central-release.mjs",
    "central:status": "node scripts/central-status.mjs",
    "verify:central-ops": "pnpm central:package && node scripts/verify-central-ops.mjs && node scripts/verify-central-ops.mjs --release .artifacts/central-release",
    "verify:central-load": "pnpm central:package && node scripts/verify-central-ops.mjs --release .artifacts/central-release --load-rounds 64",
    "demo:clients": "pnpm build && node scripts/start-test-clients.mjs",
    "build": "pnpm build:host && pnpm --filter @more-than-chat/desktop build && node scripts/stage-host-resources.mjs && node scripts/package-dir.mjs --if-ci",
    "stage:host": "node scripts/stage-host-resources.mjs",
    "package:dir": "pnpm build && node scripts/package-dir.mjs",
    "test": "pnpm build:host && pnpm -r --if-present test",
    "verify:plugin-ui": "pnpm build && node scripts/verify-plugin-ui.mjs",
    "verify:host": "pnpm build && node scripts/verify-plugin-ui.mjs --host",
    "verify:ai-ui": "pnpm build && node scripts/verify-ai-ui.mjs",
    "verify:chat-ui": "pnpm build && node scripts/verify-chat-core-ui.mjs",
    "verify:central-ui": "pnpm build && node scripts/verify-central-ui.mjs",
    "verify:background-ui": "pnpm build && node scripts/verify-background-ui.mjs",
    "verify:history-ui": "pnpm build && node scripts/verify-history-ui.mjs",
    "verify:appearance-ui": "pnpm build && node scripts/verify-appearance-ui.mjs",
    "test:live-ai": "pnpm build:host && node scripts/test-live-ai.mjs",
    "verify:protocol": "pnpm --filter @more-than-chat/protocol build && node scripts/verify-protocol-schema.mjs",
    "typecheck": "pnpm --filter @more-than-chat/central-protocol build && pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
