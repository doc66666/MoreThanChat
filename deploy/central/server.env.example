# systemd EnvironmentFile syntax, not a shell script. Never put a token here.
MTC_SERVER_MODE=private
MTC_SERVER_HOST=127.0.0.1
MTC_SERVER_PORT=8787
MTC_SERVER_DATA_DIR=/var/lib/more-than-chat
MTC_SERVER_NAME="MoreThanChat private relay"
# Add full global UIDs, separated by commas. Empty private whitelist denies everyone.
MTC_SERVER_WHITELIST=
# For a public server use public mode and its blacklist instead.
MTC_SERVER_BLACKLIST=
