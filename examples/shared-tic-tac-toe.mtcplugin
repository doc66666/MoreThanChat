{
  "manifest": {
    "manifestVersion": 1,
    "id": "example.shared-game",
    "version": "0.1.0",
    "displayName": "共享井字棋",
    "description": "同一份可执行代码支持本机、好友与群聊，插件自己处理规则、快照和本地存档。",
    "targets": [
      "pc-ui"
    ],
    "engine": {
      "moreThanChat": "^0.1.0"
    },
    "permissions": [
      "client.trusted"
    ],
    "services": {
      "requires": [
        "ui.surfaces",
        "chat.network"
      ]
    }
  },
  "program": {
    "kind": "executable-client",
    "code": "export default async function activate(ctx, sdk) {\n  const {React:R,network,conversation}=sdk, h=R.createElement, listeners=new Set();\n  const localId=conversation?.userId||'local';\n  const key='mtc-demo-game:'+ctx.manifest.id;\n  const fresh=()=>({board:Array(9).fill(null),players:[],turn:0,winner:null,round:1});\n  let state=fresh(), sequence=0, stopped=false, problem='', buffered=[], ready=false;\n  const seen=new Set();\n  try {const old=JSON.parse(localStorage.getItem(key)||'null');if(old&&Array.isArray(old.state?.board)&&old.state.board.length===9){state=old.state;sequence=old.sequence||0;}} catch {}\n  function publish(){if(stopped)return;try{localStorage.setItem(key,JSON.stringify({state,sequence}));}catch{}for(const listener of listeners)listener();}\n  function action(payload,actor) {\n    if(!payload||typeof payload!=='object')return;\n    if(payload.op&&seen.has(payload.op))return;\n    if(payload.op){seen.add(payload.op);if(seen.size>2000)seen.delete(seen.values().next().value);}\n    if(payload.type==='join'&&!state.players.includes(actor)&&state.players.length<2)state.players.push(actor);\n    if(payload.type==='leave'&&state.players.includes(actor)){const remaining=state.players.filter(p=>p!==actor);state={...fresh(),players:remaining,round:state.round+1};}\n    if(payload.type==='reset'&&state.winner){state={...fresh(),round:state.round+1};}\n    if(payload.type==='move'&&state.players.length===2&&!state.winner&&actor===state.players[state.turn]&&Number.isInteger(payload.cell)&&payload.cell>=0&&payload.cell<9&&!state.board[payload.cell]){\n      const mark=state.turn===0?'X':'O';state.board[payload.cell]=mark;\n      for(const [a,b,c] of [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]])if(state.board[a]&&state.board[a]===state.board[b]&&state.board[b]===state.board[c])state.winner=actor;\n      if(!state.winner&&state.board.every(Boolean))state.winner='draw';\n      state.turn=1-state.turn;\n    }\n  }\n  function consume(event) {\n    if(stopped||!event.trace)return;\n    const seq=event.trace.stateRevision||0, actor=event.trace.actorId;\n    if(event.channel==='snapshot'&&event.payload?.target===localId&&Number.isSafeInteger(event.payload.sequence)&&event.payload.sequence>sequence&&event.payload.sequence<seq&&Array.isArray(event.payload.state?.board)&&event.payload.state.board.length===9){\n      state=event.payload.state;sequence=event.payload.sequence;publish();return;\n    }\n    if(event.channel==='hello'&&actor!==localId&&sequence>0){\n      network.send('snapshot',{target:actor,state,sequence}).catch(error=>{problem=error.message;publish();});return;\n    }\n    if(event.channel!=='action'||seq<=sequence)return;\n    action(event.payload,actor);sequence=seq;publish();\n  }\n  if(network){\n    ctx.effect(network.subscribe(event=>{if(ready)consume(event);else buffered.push(event);}));\n    const history=await network.history();\n    const events=[...history,...buffered].sort((a,b)=>(a.trace?.stateRevision||0)-(b.trace?.stateRevision||0));\n    ready=true;buffered=[];\n    // Historical hello messages must not cause a storm of snapshot replies.\n    for(const event of events)if(event.channel!=='hello')consume(event);\n    await network.send('hello',{});\n  }else ready=true;\n  ctx.effect(()=>{stopped=true;listeners.clear();});\n  async function send(type,cell){\n    problem='';\n    try{\n      const payload={type,cell,op:crypto.randomUUID()};\n      if(network)await network.send('action',payload);\n      else {const actor=type==='join'?(state.players.length?'local-2':'local'):state.players[state.turn]||'local';action(payload,actor);sequence++;publish();}\n    }catch(error){problem=error.message;publish();}\n  }\n  function Game(){\n    const [,refresh]=R.useState(0);\n    R.useEffect(()=>{const listener=()=>refresh(n=>n+1);listeners.add(listener);return()=>listeners.delete(listener);},[]);\n    const canMove=!state.winner&&state.players.length===2&&(!network||state.players[state.turn]===localId);\n    return h('section',{'data-shared-game':conversation?.kind||'local',style:{padding:'10px 16px',display:'flex',gap:20,alignItems:'center',borderBottom:'1px solid var(--border)',flexWrap:'wrap'}},\n      h('div',null,h('strong',null,'共享井字棋'),h('p',{'data-game-status':true},'第 '+state.round+' 局 · '+state.players.length+'/2 人 · '+(state.winner?(state.winner==='draw'?'平局':'已结束'):canMove?'轮到你':'等待玩家')),\n        h('button',{'data-shared-join':true,disabled:state.players.length>=2||!!network&&state.players.includes(localId),onClick:()=>send('join')},'加入对局'),\n        h('button',{'data-shared-leave':true,disabled:!!network&&!state.players.includes(localId),onClick:()=>send('leave')},'退座'),\n        h('button',{'data-shared-reset':true,disabled:!state.winner,onClick:()=>send('reset')},'新一局（释放席位）')),\n      h('div',{style:{display:'grid',gridTemplateColumns:'repeat(3,32px)',gap:3}},state.board.map((mark,cell)=>h('button',{key:cell,'data-shared-cell':cell,style:{height:28},disabled:!canMove||!!mark,onClick:()=>send('move',cell)},mark||'·'))),\n      problem?h('p',{role:'alert'},problem):null);\n  }\n  ctx.contribute(ctx.getService('ui.surfaces'),{id:'game',surface:'root',priority:-10,render:({defaultView})=>h('div',{style:{height:'100%',display:'flex',flexDirection:'column'}},h(Game),h('div',{style:{flex:1,minHeight:0}},defaultView))});\n}"
  }
}
